# ================================
# API 密钥配置
# ================================

# 通义千问 API Key（推荐国内用户）
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 可选: Groq API（免费 + 极速推理，需要网络环境）
# 获取地址: https://console.groq.com/
# GROQ_API_KEY=your_groq_api_key_here

# 可选: 其他 API（如果需要）
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ================================
# 应用配置
# ================================

# 应用端口
PORT=8501

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ================================
# 模型配置
# ================================

# LLM 提供商 (qwen, groq, openai, anthropic)
LLM_PROVIDER=qwen

# 通义千问模型选项
# - qwen-max (最新最强模型，推荐)
# - qwen-plus (较强)
# - qwen-turbo (速度快，性价比高)
LLM_MODEL=qwen-max

# 视觉识题模型（拍照上传题目时使用，与 LLM 共用 DASHSCOPE_API_KEY）
# - qwen-vl-max（默认）
# - qwen-vl-plus
VISION_MODEL=qwen-vl-max

# Groq 模型选项 (完全免费，需要国际网络)
# - llama-3.3-70b-versatile (推荐，最强)
# - llama-3.1-70b-versatile
# - mixtral-8x7b-32768
# - gemma2-9b-it
# LLM_MODEL=llama-3.3-70b-versatile

# 温度参数 (0.0 - 1.0, 越高越随机)
LLM_TEMPERATURE=0.7

# 最大令牌数
MAX_TOKENS=4096

# ================================
# 向量数据库配置
# ================================

# ChromaDB 持久化路径
CHROMA_PERSIST_DIR=./data/chroma

# ================================
# 知识库配置
# ================================

# 知识库文件路径
KNOWLEDGE_BASE_PATH=./data/knowledge

# 向量检索返回数量
TOP_K_RETRIEVAL=5


# ================================
# 登录凭据（不配置则使用演示账号）
# ================================

# 修改后重启应用生效
APP_USERNAME=student
APP_PASSWORD=study2026

# ================================
# 主动复习（可选）
# ================================

# 飞书自定义机器人 webhook。留空则 python -m backend.workers.review_push
# 只把晨间卡片写入本地发件箱，不发起网络请求。
# REVIEW_WEBHOOK_URL=
