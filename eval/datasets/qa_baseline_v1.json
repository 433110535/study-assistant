    {"id": "q007", "input": "什么是反向传播？请按概念讲解，并给一个生活类比。", "expected_tools": ["explain_concept"], "tags": ["explain"]},
    {"id": "q008", "input": "解释一下什么是特征向量，学科是线性代数。", "expected_tools": ["explain_concept"], "tags": ["explain"]},
