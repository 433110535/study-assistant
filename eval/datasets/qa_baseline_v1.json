    {"id": "q016", "input": "出 3 道关于牛顿第二定律的中等难度练习题，要有答案和解析。", "expected_tools": ["generate_questions"], "tags": ["quiz"]},
    {"id": "q017", "input": "围绕 Python 列表和元组出 2 道简单练习题。", "expected_tools": ["generate_questions"], "tags": ["quiz"]},
    {"id": "q018", "input": "请生成 4 道微积分极限的困难题。", "expected_tools": ["generate_questions"], "tags": ["quiz"]},
