    {"id": "q029", "input": "这张作业照片里的题怎么做？先读图。\n[题目图片路径] data/uploads/homework.jpg", "expected_tools": ["read_image"], "tags": ["vision"]},
    {"id": "q030", "input": "请识别图片中的公式后再对照教材讲解。\n[题目图片路径] data/uploads/formula.png", "expected_tools": ["read_image", "rag_search"], "tags": ["vision", "rag"]},
    {"id": "q031", "input": "我不需要计划，只要告诉我今天该不该喝水。", "expected_tools": [], "tags": ["direct"]},
    {"id": "q032", "input": "用类比解释什么是递归，不要出题。", "expected_tools": ["explain_concept"], "tags": ["explain"]},
    {"id": "q033", "input": "帮我做一份 5 天的高数积分复习计划，目标是会算不定积分。", "expected_tools": ["generate_study_plan"], "tags": ["plan"]},
    {"id": "q034", "input": "出 1 道关于哈希表冲突的简单题。", "expected_tools": ["generate_questions"], "tags": ["quiz"]},
    {"id": "q035", "input": "我的笔记里有没有提到学习率调度？请检索。", "expected_tools": ["rag_search"], "tags": ["rag"]},
    {"id": "q036", "input": "图片路径是 data/uploads/q36.png，请只识别题干，先不要解答。", "expected_tools": ["read_image"], "tags": ["vision"]},
    {"id": "q037", "input": "讲解完正态分布后，再出 2 道简单练习。", "expected_tools": ["explain_concept", "generate_questions"], "tags": ["explain", "quiz"]},
    {"id": "q038", "input": "根据知识库内容，为「支持向量机」做一份 14 天学习计划，目标是能解释间隔最大化。", "expected_tools": ["rag_search", "generate_study_plan"], "tags": ["rag", "plan"]},
    {"id": "q039", "input": "谢谢，本次对话到这里就可以。", "expected_tools": [], "tags": ["direct"]},
    {"id": "q040", "input": "请确认：如果消息里有题目图片路径，你的第一步应该做什么？现在路径是 data/uploads/q40.png。", "expected_tools": ["read_image"], "tags": ["vision"]}
  ]
